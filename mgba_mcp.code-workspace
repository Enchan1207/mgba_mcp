{
  "folders": [
    {
      "path": "./server",
    },
    {
      "path": "./client",
    },
    {
      "path": "./mcp",
    },
    {
      "path": "./docs",
    },
    {
      "name": "(root)",
      "path": "./",
    },
  ],
  "settings": {
    "swift.autoGenerateLaunchConfigurations": false,
    "cmake.sourceDirectory": "${workspaceFolder}/mgba_server",
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
      "source.format.oxc": "always",
      "source.organizeImports": "always",
    },
    "oxc.configPath": "./mcp/oxlint.config.ts",
    "oxc.path.oxlint": "../mcp/node_modules/.bin/oxlint",
    "oxc.path.tsgolint": "../mcp/node_modules/.bin/tsgolint",
  },
}
