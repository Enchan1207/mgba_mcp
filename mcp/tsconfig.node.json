{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "rootDir": ".",
    "noEmit": true,
    "composite": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["vitest.config.ts", "oxfmt.config.ts"]
}
